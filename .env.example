# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings -> API). Never commit .env.local.

# --- Client-safe (exposed to the browser; NEXT_PUBLIC_ prefix required) ---

# Your Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (Supabase's current name for the client-safe key,
# shown on the API settings page as "Publishable key"). If your project
# still shows a legacy "anon / public" key instead, use that value here —
# it fills the same role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The canonical URL of this deployment (no trailing slash). Used to build
# absolute redirect URLs for Supabase auth emails (signup confirmation,
# password reset), see lib/site-url.ts. Must also be added to
# `additional_redirect_urls` in supabase/config.toml (local) or the
# project's Auth > URL Configuration (hosted) or Supabase will reject the
# redirect. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secret (NEVER prefix with NEXT_PUBLIC_, never sent to the browser) ---

# The secret key (Supabase's current name for the service-role key, shown
# as "Secret key" on the API settings page). If your project still shows
# a legacy "service_role" key instead, use that value here. Required for
# privileged server-side operations (e.g. SECURITY DEFINER-style admin
# tasks) later in the project — not used by any Sprint 0 code yet.
SUPABASE_SECRET_KEY=
